#!/usr/bin/env python3
import cmd, sqlite3, datetime, os, re, shlex, shutil, subprocess

APP_DIR = os.path.expanduser("~/.local/share/routine")
DB_PATH = os.path.join(APP_DIR, "routine.db")
LOG_PATH = os.path.join(APP_DIR, "routine.log")

DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
DAY_LOOKUP = {}
for _abbr, _full in zip(DAYS, ["monday", "tuesday", "wednesday", "thursday",
                               "friday", "saturday", "sunday"]):
    DAY_LOOKUP[_abbr.lower()] = _abbr
    DAY_LOOKUP[_full] = _abbr

COMMANDS = ["add", "edit", "index", "layout", "log", "exit", "help"]

# Input limits
MAX_NAME_LEN = 40
MAX_EXERCISES = 20
MAX_SETS, MAX_REPS, MAX_WEIGHT = 99, 999, 9999

# ASCII digits only (\d would also match other Unicode digits).
NUM_RE = re.compile(r"[0-9]+")
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ,()\-]*")
EXERCISE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 \-]*")
# SETSxREPS with an optional weight: "6x5", "6x5 25lb", "3x10 12.5 kg"
TARGET_RE = re.compile(r"([0-9]+)x([0-9]+)(?:\s+([0-9]+(?:\.[0-9]{1,2})?)\s*(lb|kg)s?)?", re.I)


class RoutineShell(cmd.Cmd):
    intro = "Welcome to Routine - Exercise Automation\nType 'help' or '?' for commands.\n"
    prompt = "(Routine) "

    def __init__(self):
        super().__init__()
        os.makedirs(APP_DIR, exist_ok=True)
        self.conn = sqlite3.connect(DB_PATH, isolation_level=None)
        self.conn.execute("PRAGMA foreign_keys = ON;")
        self.conn.row_factory = sqlite3.Row
        self.current_group_id, self.date_format = None, 1
        self._init_db()

    def _init_db(self):
        self.conn.executescript('''
            CREATE TABLE IF NOT EXISTS groups (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT UNIQUE,
                days TEXT,
                add_reps INTEGER DEFAULT 0,
                add_cycles INTEGER DEFAULT 0
            );
            CREATE TABLE IF NOT EXISTS exercises (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                group_id INTEGER,
                name TEXT,
                reps_sets TEXT,
                FOREIGN KEY (group_id) REFERENCES groups(id) ON DELETE CASCADE
            );''')

    def update_prompt(self):
        name = ""
        if self.current_group_id:
            row = self.conn.execute("SELECT name FROM groups WHERE id=?", (self.current_group_id,)).fetchone()
            name = row["name"] if row else ""
        self.prompt = f"(Routine) [{name}] " if name else "(Routine) "

    # ------------------------------------------------------------------
    # Shell behaviour
    # ------------------------------------------------------------------
    def emptyline(self):
        """Pressing Enter on a blank line does nothing (cmd's default would
        silently re-run the previous command, e.g. a second 'log add')."""
        pass

    def default(self, line):
        print(f"!! Unknown command '{line.split()[0]}'. Type 'help' for commands.")

    # ------------------------------------------------------------------
    # Prompting and validation helpers
    # ------------------------------------------------------------------
    def _get_input(self, label, validator=None, default=None):
        """Prompt until the value passes `validator`.

        A validator is a callable that returns the cleaned-up value or raises
        ValueError with a message explaining what is wrong. Pressing Enter
        accepts `default` (which is validated too) when one is given.
        Ctrl+C / Ctrl+D cancel the whole command."""
        while True:
            try:
                p = f"{label} [{default}]: " if default is not None else f"{label}: "
                val = input(p).strip()
            except (KeyboardInterrupt, EOFError):
                print("\n!! Command cancelled.")
                raise KeyboardInterrupt

            if not val:
                if default is None:
                    print("!! A value is required")
                    continue
                val = str(default)

            try:
                return validator(val) if validator else val
            except ValueError as e:
                print(f"!! {e}")

    def _confirm(self, label):
        """Strict yes/no prompt. Enter means No."""
        while True:
            try:
                ans = input(f"{label} [y/N] ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print()
                return False
            if ans in ("", "n", "no"):
                return False
            if ans in ("y", "yes"):
                return True
            print("!! Please answer y or n")

    @staticmethod
    def _v_name(v):
        v = " ".join(v.split())
        if len(v) > MAX_NAME_LEN:
            raise ValueError(f"Name must be {MAX_NAME_LEN} characters or fewer")
        if not NAME_RE.fullmatch(v):
            raise ValueError("Use letters, numbers, spaces, commas, hyphens and parentheses, "
                             "starting with a letter or number")
        return v

    def _v_group_name(self, v, exclude_id=None):
        name = self._v_name(v)
        sql, args = "SELECT id FROM groups WHERE name = ? COLLATE NOCASE", [name]
        if exclude_id:
            sql, args = sql + " AND id != ?", args + [exclude_id]
        if self.conn.execute(sql, args).fetchone():
            raise ValueError(f"A workout group named '{name}' already exists")
        return name

    @staticmethod
    def _v_exercises(v):
        parts = [" ".join(p.split()) for p in v.split(",")]
        if any(not p for p in parts):
            raise ValueError("Empty exercise name (check for extra commas)")
        if len(parts) > MAX_EXERCISES:
            raise ValueError(f"At most {MAX_EXERCISES} exercises per group")
        seen = set()
        for p in parts:
            if len(p) > MAX_NAME_LEN:
                raise ValueError(f"'{p}' is too long (max {MAX_NAME_LEN} characters)")
            if not EXERCISE_RE.fullmatch(p):
                raise ValueError(f"'{p}' is not a valid exercise name. Use letters, numbers, "
                                 "spaces and hyphens, starting with a letter or number")
            if p.lower() in seen:
                raise ValueError(f"Duplicate exercise '{p}'")
            seen.add(p.lower())
        return ", ".join(parts)

    @staticmethod
    def _v_target(v):
        m = TARGET_RE.fullmatch(v.strip())
        if not m:
            raise ValueError("Use SETSxREPS with an optional weight in lb or kg, e.g. 3x8 or 6x5 25lb")
        sets, reps, weight, unit = m.groups()
        if not 1 <= int(sets) <= MAX_SETS:
            raise ValueError(f"Sets must be between 1 and {MAX_SETS}")
        if not 1 <= int(reps) <= MAX_REPS:
            raise ValueError(f"Reps must be between 1 and {MAX_REPS}")
        out = f"{int(sets)}x{int(reps)}"
        if weight is not None:
            w = float(weight)
            if not 0 < w <= MAX_WEIGHT:
                raise ValueError(f"Weight must be greater than 0 and at most {MAX_WEIGHT}")
            out += f" {w:g}{unit.lower()}"
        return out

    @staticmethod
    def _v_days(v):
        tokens = [t for t in re.split(r"[,\s]+", v.strip()) if t]
        if not tokens:
            raise ValueError("Enter at least one day (e.g. Mon, Wed, Fri)")
        chosen = set()
        for t in tokens:
            day = DAY_LOOKUP.get(t.lower())
            if not day:
                raise ValueError(f"'{t}' is not a valid day. Use Mon, Tue, Wed, Thu, Fri, Sat, Sun")
            chosen.add(day)
        return ",".join(d for d in DAYS if d in chosen)

    def _parse_indices(self, arg, groups):
        """Strictly parse a list of group indices: single numbers (2), lists
        (1,3 or 1 3) and ranges (1-3). Returns a list of group ids, or None
        (after printing why) if anything is invalid or out of range."""
        if not groups:
            print("!! No groups to remove.")
            return None
        parts = arg.replace(",", " ").split()
        if not parts:
            print("!! Specify valid numerical indices to remove.")
            return None

        resolved = []
        for part in parts:
            m = re.fullmatch(r"([0-9]+)(?:-([0-9]+))?", part)
            if not m:
                print(f"!! Invalid index '{part}'. Use numbers, lists (1,3) or ranges (1-3).")
                return None
            start = int(m.group(1))
            end = int(m.group(2)) if m.group(2) else start
            if start > end:
                print(f"!! Invalid range '{part}'.")
                return None
            if start < 1 or end > len(groups):
                print(f"!! Index out of range in '{part}' (valid: 1-{len(groups)}).")
                return None
            for idx in range(start, end + 1):
                gid = groups[idx - 1]['id']
                if gid not in resolved:
                    resolved.append(gid)
        return resolved

    def _resolve_id(self, arg):
        """Resolve one group id. Empty arg means the currently selected
        group; otherwise arg must be exactly one valid index. Prints the
        reason and returns None on failure."""
        arg = arg.strip()
        if not arg:
            if self.current_group_id:
                return self.current_group_id
            print("!! No group selected. Pass an index or use 'index N' first.")
            return None
        if not NUM_RE.fullmatch(arg):
            print(f"!! Invalid index '{arg}'. Use a single positive number.")
            return None

        groups = self.conn.execute("SELECT id FROM groups ORDER BY id").fetchall()
        if not groups:
            print("!! No groups yet. Use 'add' to create one.")
            return None
        idx = int(arg)
        if 1 <= idx <= len(groups):
            return groups[idx - 1]['id']
        print(f"!! Index out of range (valid: 1-{len(groups)}).")
        return None

    # ------------------------------------------------------------------
    # Commands
    # ------------------------------------------------------------------
    def do_help(self, arg):
        """Show command list or specific command help."""
        topic = arg.strip()
        if not topic:
            for c in COMMANDS: print(c)
        elif topic in COMMANDS:
            print(getattr(self, f'do_{topic}').__doc__)
        else:
            print(f"!! No help for '{topic}'")

    def do_add(self, arg):
        """Add a new workout group with per-exercise sets x reps and optional weight (e.g. 6x5 25lb)."""
        if arg.strip():
            return print("!! Usage: add")
        try:
            name = self._get_input("Group Name", self._v_group_name)
            exs_str = self._get_input("Exercises (comma-separated)", self._v_exercises)
            ex_list = [e.strip() for e in exs_str.split(",")]

            ex_targets = []
            for ex in ex_list:
                targets = self._get_input(f"Sets x Reps [{ex}] (optional weight, e.g. 6x5 25lb)", self._v_target)
                ex_targets.append((ex, targets))

            days = self._get_input("Days (e.g. Mon, Wed, Fri)", self._v_days)

            with self.conn:
                cur = self.conn.execute("INSERT INTO groups (name, days, add_reps, add_cycles) VALUES (?,?,0,0)", (name, days))
                for ex, targets in ex_targets:
                    self.conn.execute("INSERT INTO exercises (group_id, name, reps_sets) VALUES (?,?,?)", (cur.lastrowid, ex, targets))
                self.current_group_id = cur.lastrowid
            self.update_prompt()
            print(f"✓ Created {name}\n")
        except sqlite3.IntegrityError:
            print("!! Error: A workout group with that name already exists.")
        except KeyboardInterrupt:
            print()

    def do_edit(self, arg):
        """Edit a workout group's details: edit [idx]"""
        gid = self._resolve_id(arg)
        if not gid: return
        try:
            g = self.conn.execute("SELECT * FROM groups WHERE id=?", (gid,)).fetchone()

            name = self._get_input("Name", lambda v: self._v_group_name(v, exclude_id=gid), default=g['name'])

            old_exs = self.conn.execute("SELECT name, reps_sets FROM exercises WHERE group_id=?", (gid,)).fetchall()
            old_exs_str = ", ".join([o['name'] for o in old_exs])

            exs_str = self._get_input("Exercises (comma-separated)", self._v_exercises, default=old_exs_str or None)
            ex_list = [e.strip() for e in exs_str.split(",")]

            old_lookup = {o['name'].lower(): o['reps_sets'] for o in old_exs}

            ex_targets = []
            for ex in ex_list:
                default_target = old_lookup.get(ex.lower(), None)
                label = f"Sets x Reps [{ex}] (optional weight, e.g. 6x5 25lb)"
                targets = self._get_input(label, self._v_target, default=default_target)
                ex_targets.append((ex, targets))

            days = self._get_input("Days (e.g. Mon, Wed, Fri)", self._v_days, default=g['days'] or None)

            with self.conn:
                self.conn.execute("UPDATE groups SET name=?, days=? WHERE id=?", (name, days, gid))
                self.conn.execute("DELETE FROM exercises WHERE group_id=?", (gid,))
                for ex, targets in ex_targets:
                    self.conn.execute("INSERT INTO exercises (group_id, name, reps_sets) VALUES (?,?,?)", (gid, ex, targets))

            self.update_prompt()
            print(f"✓ Updated {name}\n")
        except sqlite3.IntegrityError:
            print("!! Error: A workout group with that name already exists.")
        except KeyboardInterrupt:
            print()

    def do_index(self, arg):
        """List groups or select by index: index [idx | remove idx]"""
        tokens = arg.split()
        groups = self.conn.execute("SELECT id, name FROM groups ORDER BY id").fetchall()

        if tokens and tokens[0] == "remove":
            ids = self._parse_indices(" ".join(tokens[1:]), groups)
            if not ids:
                return

            names = [g['name'] for g in groups if g['id'] in ids]
            print(f"Removing: {', '.join(names)}")
            if not self._confirm("Confirm?"):
                print("Cancelled.")
                return

            self.conn.executemany("DELETE FROM groups WHERE id=?", [(i,) for i in ids])
            if self.current_group_id in ids: self.current_group_id = None
            print("✓ Removed selected groups.")
            return self.update_prompt()

        if tokens:
            if len(tokens) != 1 or not NUM_RE.fullmatch(tokens[0]):
                return print("!! Usage: index [idx | remove idx]")
            gid = self._resolve_id(tokens[0])
            if not gid: return
            self.current_group_id = gid
            self.update_prompt()

        if not groups:
            return print("No groups yet. Use 'add' to create one.")
        for i, g in enumerate(groups, 1):
            print(f"{'*' if self.current_group_id == g['id'] else ' '} {i}. {g['name']}")

    def do_layout(self, arg):
        """Display schedule or workout details: layout [NUM | date 1-4 | export]"""
        tokens = arg.split()
        has_export = False
        target_arg = None

        if not tokens:
            pass
        elif tokens == ["export"]:
            has_export = True
        elif len(tokens) == 2 and tokens[0] == "date" and NUM_RE.fullmatch(tokens[1]):
            date_val = int(tokens[1])
            if date_val not in (1, 2, 3, 4):
                return print("!! Date format must be between 1 and 4.")
            self.date_format = date_val
            return print(f"✓ Date format set to {self.date_format}\n")
        elif len(tokens) == 1 and NUM_RE.fullmatch(tokens[0]):
            target_arg = tokens[0]
        else:
            return print("!! Invalid command usage. Use only one of: layout [NUM | date 1-4 | export]")

        lines = ["--- SCHEDULE ---"]
        fmts = {1: "%a", 2: "%A", 3: "%m/%d", 4: "%m/%d/%Y"}
        fmt = fmts.get(self.date_format, "%a")

        target_gid = None
        if target_arg is not None:
            target_gid = self._resolve_id(target_arg)
            if not target_gid:
                return

        groups_query = "SELECT * FROM groups WHERE id=?" if target_gid else "SELECT * FROM groups"
        groups_args = [target_gid] if target_gid else []
        groups = self.conn.execute(groups_query, groups_args).fetchall()

        # Weekday-name formats (1 and 2) always run Monday -> Sunday of the
        # current week; date-number formats (3 and 4) roll forward from today.
        today = datetime.date.today()
        if self.date_format in (1, 2):
            start = today - datetime.timedelta(days=today.weekday())
        else:
            start = today

        for i in range(1 if target_gid else 7):
            date = start + datetime.timedelta(days=i)
            active = [g for g in groups if target_gid or DAYS[date.weekday()] in (g['days'] or "")]

            if active:
                if not target_gid:
                    lines.append(date.strftime(fmt))
                for g in active:
                    lines.append(f"{g['name']}")
                    exs = self.conn.execute("SELECT * FROM exercises WHERE group_id=?", (g['id'],)).fetchall()
                    for e in exs:
                        lines.append(f" {e['reps_sets']} {e['name']}")
                lines.append("")

        output_text = "\n".join(lines).rstrip("\n") + "\n"
        print(output_text, end="")

        if has_export:
            fn = f"schedule_{datetime.date.today()}.txt"
            try:
                with open(fn, "w") as f:
                    f.write(output_text)
                print(f"✓ Exported layout to {fn}\n")
            except OSError as e:
                print(f"!! Could not write {fn}: {e}")

    def _find_editor(self):
        """Pick an editor: $VISUAL, then $EDITOR, then nano/vim/vi."""
        for var in ("VISUAL", "EDITOR"):
            val = os.environ.get(var, "").strip()
            if val:
                try:
                    return shlex.split(val)
                except ValueError:
                    continue
        for name in ("nano", "vim", "vi"):
            if shutil.which(name):
                return [name]
        return None

    def do_log(self, arg):
        """Add to log, view it, or edit it: log add [idx] | log layout | log edit"""
        usage = "!! Usage: log add [idx] | log layout | log edit"
        tokens = arg.split()
        sub = tokens[0] if tokens else ""

        if sub == "layout" and len(tokens) == 1:
            if os.path.exists(LOG_PATH):
                with open(LOG_PATH, "r") as f: print(f.read())
            else:
                print("!! No log file found.")
        elif sub == "edit" and len(tokens) == 1:
            editor = self._find_editor()
            if not editor:
                return print("!! No editor found. Set $EDITOR (e.g. export EDITOR=nano).")
            try:
                subprocess.call(editor + [LOG_PATH])
            except OSError as e:
                print(f"!! Could not launch editor '{editor[0]}': {e}")
        elif sub == "add" and len(tokens) <= 2:
            gid = self._resolve_id(tokens[1] if len(tokens) == 2 else "")
            if not gid: return
            g = self.conn.execute("SELECT name FROM groups WHERE id=?", (gid,)).fetchone()
            exs = self.conn.execute("SELECT name, reps_sets FROM exercises WHERE group_id=?", (gid,)).fetchall()

            ex_details = ", ".join([f"{e['name']} ({e['reps_sets']})" for e in exs])
            try:
                with open(LOG_PATH, "a") as f:
                    f.write(f"{datetime.date.today()} - {g['name']}: {ex_details}\n")
                print("✓ Logged")
            except OSError as e:
                print(f"!! Could not write log: {e}")
        else:
            print(usage)

    def do_exit(self, arg):
        """Exit the program."""
        if arg and arg.strip():
            return print("!! 'exit' takes no arguments.")
        print("...")
        self.conn.close()
        return True

    def do_EOF(self, arg):
        return self.do_exit(None)

if __name__ == "__main__":
    try:
        RoutineShell().cmdloop()
    except KeyboardInterrupt:
        print("\nUse 'exit' to quit.")
